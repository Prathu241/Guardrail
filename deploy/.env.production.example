# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env.production and
# keep that file out of version control (it holds secrets).

# Public hostname; Caddy obtains its HTTPS certificate automatically (DNS must point here)
DOMAIN=guardrail.example.com

# Who may call the API: name:role:secret, comma-separated. Roles: agent, approver, operator, admin.
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GUARDRAIL_API_KEYS=support-bot:agent:CHANGE-ME-agent-secret-32-chars-min,morgan.lee:approver:CHANGE-ME-approver-secret-32-chars,ops:operator:CHANGE-ME-operator-secret-32-chars

# Model review is required in production
ANTHROPIC_API_KEY=
GUARDRAIL_REVIEWER=claude
# rules = the built-in offline agent; claude = Claude as the support agent
GUARDRAIL_AGENT=claude

GUARDRAIL_REVIEWER_TIMEOUT=30
GUARDRAIL_AGENT_TIMEOUT=120
GUARDRAIL_APPROVAL_TTL_HOURS=24
GUARDRAIL_WORKER_INTERVAL=2
GUARDRAIL_RECONCILE_INTERVAL=60
