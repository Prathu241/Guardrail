# Copy to .env and adjust. Every setting is optional.
GUARDRAIL_DB_PATH=/data/guardrail.db
# heuristic (offline) | claude
GUARDRAIL_REVIEWER=heuristic
# rules (offline) | claude
GUARDRAIL_AGENT=rules
GUARDRAIL_FAST_MODEL=claude-haiku-5-5
GUARDRAIL_CAREFUL_MODEL=claude-opus-5-5
GUARDRAIL_AGENT_MODEL=claude-opus-5-5
GUARDRAIL_CRITICAL_MODEL=claude-sonnet-5-5
# Claude call limits; a reviewer that times out fails closed (to a human)
GUARDRAIL_REVIEWER_TIMEOUT=30
GUARDRAIL_REVIEWER_MAX_RETRIES=2
GUARDRAIL_AGENT_TIMEOUT=120
GUARDRAIL_AGENT_MAX_RETRIES=2
GUARDRAIL_RISK_THRESHOLD=0.5
GUARDRAIL_CASCADE_BELOW_CONFIDENCE=0.75
GUARDRAIL_CRITICAL_THRESHOLD=0.8
GUARDRAIL_BLOCK_CONFIDENCE=0.7
# Human approvals expire this long after the action was escalated
GUARDRAIL_APPROVAL_TTL_HOURS=24
# Background delivery of refunds and messages (0 turns the worker off), reconciliation interval
GUARDRAIL_WORKER_INTERVAL=2
GUARDRAIL_RECONCILE_INTERVAL=60
GUARDRAIL_OUTBOX_MAX_ATTEMPTS=5
GUARDRAIL_OUTBOX_BACKOFF_SECONDS=2
# Chaos testing: 0 = off, 1 = corrupt every agent turn
GUARDRAIL_FAULT_RATE=0
# Required only when GUARDRAIL_REVIEWER or GUARDRAIL_AGENT is "claude"
ANTHROPIC_API_KEY=
