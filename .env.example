# Copy to .env and adjust. Every setting is optional.
GUARDRAIL_DB_PATH=/data/guardrail.db
# heuristic (offline) | claude
GUARDRAIL_REVIEWER=heuristic
# rules (offline) | claude
GUARDRAIL_AGENT=rules
GUARDRAIL_FAST_MODEL=claude-haiku-5-5
GUARDRAIL_CAREFUL_MODEL=claude-opus-5-5
GUARDRAIL_AGENT_MODEL=claude-opus-5-5
GUARDRAIL_RISK_THRESHOLD=0.5
GUARDRAIL_CASCADE_BELOW_CONFIDENCE=0.75
GUARDRAIL_BLOCK_CONFIDENCE=0.7
# Chaos testing: 0 = off, 1 = corrupt every agent turn
GUARDRAIL_FAULT_RATE=0
# Required only when GUARDRAIL_REVIEWER or GUARDRAIL_AGENT is "claude"
ANTHROPIC_API_KEY=
